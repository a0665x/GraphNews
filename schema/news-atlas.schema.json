{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "News Atlas graph export v2",
  "type": "object",
  "required": [
    "schema_version",
    "articles",
    "relations"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "articles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/article"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "search": {
      "type": "object"
    },
    "relation_note": {
      "type": "string"
    },
    "channel_definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "keywords",
          "match",
          "color"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "match": {
            "enum": [
              "any",
              "all"
            ]
          },
          "color": {
            "type": "string",
            "pattern": "^#[a-fA-F0-9]{6}$"
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "provider",
        "publisher"
      ],
      "properties": {
        "provider": {
          "enum": [
            "google",
            "yahoo",
            "massive"
          ]
        },
        "publisher": {
          "type": "string"
        },
        "via": {
          "type": "string"
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "label",
        "method",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "method": {
          "enum": [
            "provider_ticker",
            "text_alias"
          ]
        },
        "field": {
          "enum": [
            "title",
            "summary"
          ]
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "article": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "url",
        "published_at",
        "source",
        "symbols",
        "language",
        "fetched_at",
        "entities",
        "topics",
        "analysis_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:(?:google|yahoo|massive)::)?[a-f0-9]{24}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "symbols": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "analysis_version": {
          "const": "rules-v1"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "method",
              "score",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "method": {
                "enum": [
                  "channel_keywords_v1",
                  "unclassified"
                ]
              },
              "score": {
                "type": "number",
                "minimum": 0
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "field",
                    "term",
                    "match"
                  ],
                  "properties": {
                    "field": {
                      "enum": [
                        "title",
                        "summary"
                      ]
                    },
                    "term": {
                      "type": "string"
                    },
                    "match": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "primary_channel": {
          "type": "string"
        },
        "channel_version": {
          "type": "string",
          "pattern": "^[a-f0-9]{16}$"
        }
      }
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "type",
        "weight",
        "method",
        "evidence",
        "days_apart"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "type": {
          "enum": [
            "shared_entity",
            "shared_topic",
            "similar_title"
          ]
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "method": {
          "const": "rules-v1"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "days_apart": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        }
      }
    }
  }
}
