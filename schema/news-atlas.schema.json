{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "News Atlas graph export v2",
  "type": "object",
  "required": [
    "schema_version",
    "articles",
    "relations"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "articles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/article"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "search": {
      "type": "object"
    },
    "relation_note": {
      "type": "string"
    },
    "channel_definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "keywords",
          "match",
          "color"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "match": {
            "enum": [
              "any",
              "all"
            ]
          },
          "color": {
            "type": "string",
            "pattern": "^#[a-fA-F0-9]{6}$"
          }
        }
      }
    },
    "view": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "enum": [
              "google",
              "yahoo",
              "massive"
            ]
          },
          "uniqueItems": true
        },
        "separate": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "network",
            "timeline"
          ]
        },
        "channel_filter": {
          "type": "string"
        },
        "cutoff": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "timeline_style": {
          "enum": [
            "density",
            "nodes"
          ]
        },
        "exploration": {
          "$ref": "#/$defs/exploration"
        },
        "channel_definitions": {
          "$ref": "#/properties/channel_definitions"
        },
        "glow": {
          "$ref": "#/$defs/glow"
        },
        "focus": {
          "$ref": "#/$defs/focus"
        },
        "time_focus": {
          "$ref": "#/$defs/time_focus"
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "provider",
        "publisher"
      ],
      "properties": {
        "provider": {
          "enum": [
            "google",
            "yahoo",
            "massive"
          ]
        },
        "publisher": {
          "type": "string"
        },
        "via": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "Requested RSS country/region edition, not publisher nationality or event location. Absent for unknown historical context or Massive."
        },
        "language": {
          "type": "string",
          "description": "Requested feed edition language; does not claim article language detection."
        },
        "sites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Domain restriction used for the Yahoo edition."
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "label",
        "method",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "method": {
          "enum": [
            "provider_ticker",
            "text_alias"
          ]
        },
        "field": {
          "enum": [
            "title",
            "summary"
          ]
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "article": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "url",
        "published_at",
        "source",
        "symbols",
        "language",
        "fetched_at",
        "entities",
        "topics",
        "analysis_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:(?:google|yahoo|massive)::)?[a-f0-9]{24}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "symbols": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "analysis_version": {
          "const": "rules-v1"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "method",
              "score",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "method": {
                "enum": [
                  "channel_keywords_v1",
                  "unclassified"
                ]
              },
              "score": {
                "type": "number",
                "minimum": 0
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "field",
                    "term",
                    "match"
                  ],
                  "properties": {
                    "field": {
                      "enum": [
                        "title",
                        "summary"
                      ]
                    },
                    "term": {
                      "type": "string"
                    },
                    "match": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "primary_channel": {
          "type": "string"
        },
        "channel_version": {
          "type": "string",
          "pattern": "^[a-f0-9]{16}$"
        }
      }
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "type",
        "weight",
        "method",
        "evidence",
        "days_apart"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "type": {
          "enum": [
            "shared_entity",
            "shared_topic",
            "similar_title"
          ]
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "method": {
          "const": "rules-v1"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "days_apart": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        }
      }
    },
    "exploration": {
      "type": "object",
      "description": "Display-only heuristic thresholds and traversal limits; scores are not probabilities.",
      "properties": {
        "internalMin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "crossMin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "default": 2
        },
        "branchLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "default": 4
        },
        "pathMin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.25
        },
        "maxNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150,
          "default": 150
        }
      }
    },
    "glow": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "brightness": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 1
        },
        "radius": {
          "type": "number",
          "minimum": 12,
          "maximum": 90,
          "default": 38
        },
        "decay": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.9,
          "default": 0.64
        },
        "background": {
          "type": "number",
          "minimum": 0.03,
          "maximum": 0.6,
          "default": 0.18
        }
      }
    },
    "focus": {
      "type": "object",
      "required": [
        "mode",
        "root_ids",
        "query",
        "limit"
      ],
      "properties": {
        "mode": {
          "enum": [
            "overview",
            "single",
            "keyword"
          ]
        },
        "root_ids": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "query": {
          "type": "string",
          "maxLength": 200
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "time_focus": {
      "type": "object",
      "description": "Visual date lens; does not filter articles or alter edge scores. Legacy snapshots without this field use constant node sizes.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "UTC focus date, clamped to the loaded graph search date range by the UI."
        },
        "peak": {
          "type": "number",
          "minimum": 1,
          "maximum": 12,
          "default": 2,
          "description": "Base Gaussian radius multiplier when profile is absent. The maximum profile gain controls depth compensation when a sculpted profile is present; compensation ramps from 2x to full at 8x."
        },
        "width": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 0.5,
          "default": 0.12,
          "description": "Gaussian sigma as a fraction of the date range, with a minimum effective width of one day."
        },
        "profile": {
          "type": "array",
          "minItems": 129,
          "maxItems": 129,
          "items": {
            "type": "number",
            "minimum": 1,
            "maximum": 12
          },
          "description": "Optional sculpted radius multipliers at 129 equally spaced offsets from -1 to +1 relative to the focus date, in units of the loaded date span (minimum one day). Log-linear interpolation, baseline 1 outside that range. Overrides peak/width; moves with the focus date. Omit to use the legacy Gaussian."
        }
      },
      "additionalProperties": false
    }
  }
}
